{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Every pinned version here lives in one of three places: the purls of the packages, the pre-commit hooks, and the actions of the CI workflow.",
    "The workflow runs the StyLua version it reads off the pre-commit hook, so that one bump covers both."
  ],
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "enabledManagers": [
    "pre-commit",
    "github-actions",
    "custom.regex"
  ],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tools the registry installs from a GitHub release",
      "managerFilePatterns": [
        "/^lua/dy-mason-registry/[^/]+\\.lua$/"
      ],
      "matchStrings": [
        "'pkg:github/(?<depName>[^@']+)@(?<currentValue>v?\\d[^']*)'"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Tools the registry installs with `go install`",
      "managerFilePatterns": [
        "/^lua/dy-mason-registry/[^/]+\\.lua$/"
      ],
      "matchStrings": [
        "'pkg:golang/(?<depName>[^@']+)@(?<currentValue>v\\d[^'#]*)(?:#[^']*)?'"
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Tools the registry installs from npm; a scoped name is written `%40scope/name` in a purl and looked up as `@scope/name`",
      "managerFilePatterns": [
        "/^lua/dy-mason-registry/[^/]+\\.lua$/"
      ],
      "matchStrings": [
        "'pkg:npm/(?:%40(?<scope>[^/@']+)/)?(?<name>[^/@']+)@(?<currentValue>\\d[^']*)'"
      ],
      "depNameTemplate": "{{#if scope}}@{{scope}}/{{/if}}{{name}}",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Tools the registry installs from PyPI",
      "managerFilePatterns": [
        "/^lua/dy-mason-registry/[^/]+\\.lua$/"
      ],
      "matchStrings": [
        "'pkg:pypi/(?<depName>[^@']+)@(?<currentValue>\\d[^']*)'"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Entries that build their purl from a version variable, and say so in a `-- renovate:` comment",
      "managerFilePatterns": [
        "/^lua/dy-mason-registry/[^/]+\\.lua$/"
      ],
      "matchStrings": [
        "--\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\nlocal version = '(?<currentValue>[^']+)'"
      ]
    },
    {
      "customType": "regex",
      "description": "Tools the registry builds with `cargo` from a commit of a repository that has no release, followed on its `main` branch",
      "managerFilePatterns": [
        "/^lua/dy-mason-registry/[^/]+\\.lua$/"
      ],
      "matchStrings": [
        "'pkg:cargo/(?<depName>[^@']+)@(?<currentDigest>[0-9a-f]{40})\\?repository_url=(?<packageName>[^&']+)&rev=true'"
      ],
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main"
    }
  ],
  "packageRules": [
    {
      "description": "A Mason bump is only picked up once the package is reinstalled by hand, so they arrive together in one pull request rather than one each.",
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "mason registry",
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "description": "Hold a release back for the same week DyNeo's `tools.mason-quarantine` and the npm, bun, pnpm and uv configurations do. Only datasources that date their releases are listed: a commit followed through `git-refs` carries no date to wait on.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-releases",
        "github-tags",
        "go",
        "npm",
        "pypi"
      ],
      "minimumReleaseAge": "7 days"
    }
  ]
}
